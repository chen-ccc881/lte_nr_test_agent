# 混元 / tokenhub API 密钥（必填）
HUNYUAN_API_KEY=your_api_key_here

# API 基址（默认 tokenhub）
HUNYUAN_API_BASE=https://tokenhub.tencentmaas.com/v1

# 模型角色配置（可选，默认值见下）
# HUNYUAN_ROUTER_MODEL=hy3
# HUNYUAN_LOG_MODEL=hy3
# HUNYUAN_RADIO_MODEL=hy3
# HUNYUAN_KNOWLEDGE_MODEL=hy3
# HUNYUAN_PROTOCOL_MODEL=hy3
# HUNYUAN_LIGHT_MODEL=hy4-flash

# Critic 评审开关（0 关闭 / 1 开启，默认 0）
# ENABLE_CRITIC=0

# RAG Embedding：local（默认，本地 bge-small-zh 语义向量，完全离线）/ hash（离线词袋兜底）
# 语义模型首次使用会下载约 90MB（缓存在用户目录，之后离线可用）
# RAG_EMBEDDING_MODE=local
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# RAG Rerank：默认开启，用 cross-encoder 对检索候选二次精排（首次下载约 570MB）
# RAG_RERANK_ENABLED=1
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# RAG_RERANK_CANDIDATES=12

# RAG 混合检索：向量语义 + BM25 关键词，RRF 融合（默认开启，无需模型下载）
# RAG_HYBRID_ENABLED=1
# RAG_WEIGHT_VECTOR=1.0
# RAG_WEIGHT_BM25=1.0

# RAG 上下文压缩/过滤：阈值过滤→去重→句子压缩→预算截断（默认开启）
# RAG_FILTER_ENABLED=1
# RAG_MIN_SCORE=-5.0
# RAG_SCORE_RATIO=0.25
# RAG_DEDUP_THRESHOLD=0.82
# RAG_CHUNK_MAX_CHARS=600
# RAG_CONTEXT_MAX_CHARS=8000

# QCAT 路径与分析器（本机安装 Qualcomm QCAT 6.x 时可配）
# QCAT_EXE=C:\Program Files (x86)\Qualcomm\Qcat 6.x\Bin\QCAT.exe
# QCAT_ANALYZERS=QCAT Sample;LTE;Summary
